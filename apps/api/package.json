    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "typescript": "~6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
